# Canonical environment template. Nested groups use a double underscore.
ENV=local
APP_NAME=atlas

# --- Chat provider selection (groq | openai | anthropic | nvidia) ---
CHAT__PROVIDER=groq
CHAT__TEMPERATURE=0.2
CHAT__MAX_TOKENS=1024
CHAT__REQUEST_TIMEOUT=60
CHAT__MAX_RETRIES=2

# --- Chat + embedding credentials ---
GROQ__API_KEY=gsk_xxx
GROQ__MODEL=llama-3.3-70b-versatile

# OpenAI or any OpenAI-compatible endpoint (set BASE_URL to its /v1 root)
OPENAI__API_KEY=
OPENAI__BASE_URL=https://api.openai.com/v1
OPENAI__MODEL=gpt-4o-mini

ANTHROPIC__API_KEY=
ANTHROPIC__BASE_URL=https://api.anthropic.com
ANTHROPIC__MODEL=claude-haiku-4-5-20251001

NVIDIA__API_KEY=nvapi-xxx
NVIDIA__CHAT_MODEL=meta/llama-3.1-8b-instruct
NVIDIA__EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA__RERANK_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v1

# --- Infrastructure ---
POSTGRES__URL=postgresql+asyncpg://atlas:atlas@postgres:5432/atlas
REDIS__URL=redis://redis:6379/0

# --- Security ---
SECURITY__API_KEYS=dev-key=tenant-a
SECURITY__PII_POLICY=mask
SECURITY__DISABLE_INJECTION_GUARD=false
SECURITY__RATE_LIMIT_RPM=120

# --- Retrieval / chunking ---
CHUNKING__ENABLE_SEMANTIC_CHUNKS=false
RETRIEVAL__ENABLE_RERANK=true
RETRIEVAL__FINAL_TOP_K=6

# --- Observability ---
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__LOG_JSON=false
OBSERVABILITY__OTLP_ENDPOINT=

# --- Chaos (fault injection; never enable in prod) ---
CHAOS__ENABLED=false
CHAOS__FAILURE_RATE=0.0
